@namespace PrintSharp.Preview.Blazor
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_container" style="height:@Height;min-height:200px" @attributes="AdditionalAttributes"></div>

@code {
    [Parameter, EditorRequired] public string DocumentId { get; set; } = "";
    [Parameter] public string BaseUrl { get; set; } = "/api/previews";
    [Parameter] public bool Toolbar { get; set; } = true;
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public double Zoom { get; set; }
    [Parameter] public EventCallback<double> ZoomChanged { get; set; }
    [Parameter] public EventCallback<int> PageCountChanged { get; set; }
    [Parameter] public EventCallback<bool> LoadingChanged { get; set; }
    [Parameter] public EventCallback Ready { get; set; }
    [Parameter] public Dictionary<string, string>? Labels { get; set; }
    [Parameter] public Dictionary<string, string>? RequestHeaders { get; set; }
    [Parameter] public string Credentials { get; set; } = "same-origin";
    private int _currentPage = 1;
    private double _currentZoom;
    private string? _configuration;
    [Parameter] public int InitialPage { get; set; } = 1;
    [Parameter] public string ViewMode { get; set; } = "single-page";
    private string? _loadedMode;
    private bool _loadedThumbnails;
    private bool _loadedTextSelection;
    [Parameter] public bool TextSelection { get; set; } = true;
    [Parameter] public EventCallback<bool> TextSelectionChanged { get; set; }
    [Parameter] public EventCallback<string> SelectionChanged { get; set; }
    [Parameter] public bool Thumbnails { get; set; }
    [Parameter] public EventCallback<bool> ThumbnailsChanged { get; set; }
    [Parameter] public string Height { get; set; } = "600px";
    [Parameter] public EventCallback<string> ViewModeChanged { get; set; }
    [Parameter] public EventCallback<PreviewSearchState> SearchChanged { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public EventCallback<string> Error { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    private ElementReference _container;
    private IJSObjectReference? _module;
    private IJSObjectReference? _preview;
    private DotNetObjectReference<PrintSharpPreview>? _callback;
    private (string, string, int)? _loaded;
    private bool _disposed;
    private bool _updating;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _updating) return;
        _updating = true;
        try
        {
            if (string.IsNullOrWhiteSpace(DocumentId))
            {
                if (_preview is not null) { await _preview.InvokeVoidAsync("destroy"); await _preview.DisposeAsync(); _preview = null; }
                _loaded = null;
                return;
            }
            var configuration = System.Text.Json.JsonSerializer.Serialize(new { Toolbar, Labels, RequestHeaders, Credentials });
            if (_loaded == (BaseUrl, DocumentId, InitialPage) && _configuration == configuration)
            {
                if (_preview is not null && _loadedMode != ViewMode) { await _preview.InvokeVoidAsync("setViewMode", ViewMode); _loadedMode = ViewMode; }
                if (_preview is not null && _loadedThumbnails != Thumbnails) { await _preview.InvokeVoidAsync("setThumbnailsVisible", Thumbnails); _loadedThumbnails = Thumbnails; }
                if (_preview is not null && _loadedTextSelection != TextSelection) { await _preview.InvokeVoidAsync("setTextSelection", TextSelection); _loadedTextSelection = TextSelection; }
                if (_preview is not null && Page != _currentPage) { _currentPage = Page; await GoToPageAsync(Page); }
                if (_preview is not null && Zoom > 0 && Zoom != _currentZoom) { _currentZoom = Zoom; await SetZoomAsync(Zoom); }
                return;
            }
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/PrintSharp.Preview.Blazor/preview.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            if (_preview is not null)
            {
                await _preview.InvokeVoidAsync("destroy");
                await _preview.DisposeAsync();
            }
            _callback?.Dispose();
            _callback = DotNetObjectReference.Create(this);
            _preview = await _module.InvokeAsync<IJSObjectReference>("mountBlazor", _container, BaseUrl, DocumentId, Page != 1 ? Page : InitialPage, Zoom > 0 ? (object)Zoom : "fit-width", _callback, ViewMode, Thumbnails, TextSelection, Toolbar, Labels, RequestHeaders, Credentials);
            if (_disposed)
            {
                await _preview.InvokeVoidAsync("destroy");
                await _preview.DisposeAsync();
                return;
            }
            _configuration = configuration;
            _loadedTextSelection = TextSelection;
            _loadedThumbnails = Thumbnails;
            _loadedMode = ViewMode;
            _loaded = (BaseUrl, DocumentId, InitialPage);
        }
        catch (JSDisconnectedException)
        {
            // 接続が失われた場合は終了し、完了していない状態を記録しません。
        }
        finally { _updating = false; }
    }

    [JSInvokable] public Task OnThumbnailsChanged(bool visible) => ThumbnailsChanged.InvokeAsync(visible);
    [JSInvokable] public Task OnViewModeChanged(string mode) => ViewModeChanged.InvokeAsync(mode);
    [JSInvokable] public Task OnSelectionChanged(string text) => SelectionChanged.InvokeAsync(text);
    [JSInvokable] public Task OnTextSelectionChanged(bool enabled) => TextSelectionChanged.InvokeAsync(enabled);
    public Task SetTextSelectionAsync(bool enabled) => InvokePreviewAsync("setTextSelection", enabled);
    public Task ClearSelectionAsync() => InvokePreviewAsync("clearSelection");
    [JSInvokable] public Task OnSearchChanged(PreviewSearchState state) => SearchChanged.InvokeAsync(state);
    public Task SearchAsync(string query) => InvokePreviewAsync("search", query);
    public Task NextSearchResultAsync() => InvokePreviewAsync("nextSearchResult");
    public Task PreviousSearchResultAsync() => InvokePreviewAsync("previousSearchResult");
    public Task CloseSearchAsync() => InvokePreviewAsync("closeSearch");
    [JSInvokable] public Task OnPageChanged(int page) { _currentPage = Page = page; return PageChanged.InvokeAsync(page); }
    [JSInvokable] public Task OnZoomChanged(double zoom) { _currentZoom = Zoom = zoom; return ZoomChanged.InvokeAsync(zoom); }
    [JSInvokable] public Task OnPageCountChanged(int count) => PageCountChanged.InvokeAsync(count);
    [JSInvokable] public Task OnLoadingChanged(bool loading) => LoadingChanged.InvokeAsync(loading);
    [JSInvokable] public Task OnReady() => Ready.InvokeAsync();
    public Task ZoomInAsync() => InvokePreviewAsync("zoomIn");
    public Task ZoomOutAsync() => InvokePreviewAsync("zoomOut");
    public string GetPdfUrl() => $"{BaseUrl.TrimEnd('/')}/{Uri.EscapeDataString(DocumentId)}/pdf";
    [JSInvokable] public Task OnPreviewError(string message) => Error.InvokeAsync(message);
    public Task SetThumbnailsVisibleAsync(bool visible) => InvokePreviewAsync("setThumbnailsVisible", visible);
    public Task SetViewModeAsync(string mode) => InvokePreviewAsync("setViewMode", mode);
    public Task GoToPageAsync(int page) => InvokePreviewAsync("goToPage", page);
    public Task SetZoomAsync(double zoom) => InvokePreviewAsync("setZoom", zoom);
    public Task FitWidthAsync() => InvokePreviewAsync("fitWidth");
    public Task FitPageAsync() => InvokePreviewAsync("fitPage");

    private async Task InvokePreviewAsync(string identifier, params object?[] args)
    {
        ObjectDisposedException.ThrowIf(_disposed, this);
        if (_preview is null) throw new InvalidOperationException("Wait for the Ready event before controlling the preview.");
        try
        {
            await _preview.InvokeVoidAsync(identifier, args);
        }
        catch (JSDisconnectedException)
        {
            // 切断後の UI 操作は終了します。他の JavaScript エラーは呼び出し元へ伝えます。
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        // 接続中は明示的に破棄し、切断時は MutationObserver に任せます。
        try
        {
            if (_preview is not null) { await _preview.InvokeVoidAsync("destroy"); await _preview.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _callback?.Dispose(); }
    }
}
