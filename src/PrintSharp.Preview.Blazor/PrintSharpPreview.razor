@namespace PrintSharp.Preview.Blazor
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_container" style="height:@Height;min-height:200px" @attributes="AdditionalAttributes"></div>

@code {
    [Parameter, EditorRequired] public string DocumentId { get; set; } = "";
    [Parameter] public string BaseUrl { get; set; } = "/api/v1/previews";
    [Parameter] public int InitialPage { get; set; } = 1;
    [Parameter] public string ViewMode { get; set; } = "single-page";
    private string? _loadedMode;
    private bool _loadedThumbnails;
    private bool _loadedTextSelection;
    [Parameter] public bool TextSelection { get; set; } = true;
    [Parameter] public EventCallback<bool> TextSelectionChanged { get; set; }
    [Parameter] public EventCallback<string> SelectionChanged { get; set; }
    [Parameter] public bool Thumbnails { get; set; }
    [Parameter] public EventCallback<bool> ThumbnailsChanged { get; set; }
    [Parameter] public string Height { get; set; } = "600px";
    [Parameter] public EventCallback<string> ViewModeChanged { get; set; }
    [Parameter] public EventCallback<PreviewSearchState> SearchChanged { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public EventCallback<string> Error { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    private ElementReference _container;
    private IJSObjectReference? _module;
    private IJSObjectReference? _preview;
    private DotNetObjectReference<PrintSharpPreview>? _callback;
    private (string, string, int)? _loaded;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || string.IsNullOrWhiteSpace(DocumentId)) return;
        try
        {
            if (_loaded == (BaseUrl, DocumentId, InitialPage))
            {
                if (_preview is not null && _loadedMode != ViewMode) { await _preview.InvokeVoidAsync("setViewMode", ViewMode); _loadedMode = ViewMode; }
                if (_preview is not null && _loadedThumbnails != Thumbnails) { await _preview.InvokeVoidAsync("setThumbnailsVisible", Thumbnails); _loadedThumbnails = Thumbnails; }
                if (_preview is not null && _loadedTextSelection != TextSelection) { await _preview.InvokeVoidAsync("setTextSelection", TextSelection); _loadedTextSelection = TextSelection; }
                return;
            }
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/PrintSharp.Preview.Blazor/preview.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            if (_preview is not null)
            {
                await _preview.InvokeVoidAsync("destroy");
                await _preview.DisposeAsync();
            }
            _callback ??= DotNetObjectReference.Create(this);
            _preview = await _module.InvokeAsync<IJSObjectReference>("mountBlazor", _container, BaseUrl, DocumentId, InitialPage, "fit-width", _callback, ViewMode, Thumbnails, TextSelection);
            _loadedTextSelection = TextSelection;
            _loadedThumbnails = Thumbnails;
            _loadedMode = ViewMode;
            _loaded = (BaseUrl, DocumentId, InitialPage);
        }
        catch (JSDisconnectedException)
        {
            // 接続が失われた場合は終了し、完了していない状態を記録しません。
        }
    }

    [JSInvokable] public Task OnThumbnailsChanged(bool visible) => ThumbnailsChanged.InvokeAsync(visible);
    [JSInvokable] public Task OnViewModeChanged(string mode) => ViewModeChanged.InvokeAsync(mode);
    [JSInvokable] public Task OnSelectionChanged(string text) => SelectionChanged.InvokeAsync(text);
    [JSInvokable] public Task OnTextSelectionChanged(bool enabled) => TextSelectionChanged.InvokeAsync(enabled);
    public ValueTask SetTextSelectionAsync(bool enabled) => InvokePreviewAsync("setTextSelection", enabled);
    public ValueTask ClearSelectionAsync() => InvokePreviewAsync("clearSelection");
    [JSInvokable] public Task OnSearchChanged(PreviewSearchState state) => SearchChanged.InvokeAsync(state);
    public ValueTask SearchAsync(string query) => InvokePreviewAsync("search", query);
    public ValueTask NextSearchResultAsync() => InvokePreviewAsync("nextSearchResult");
    public ValueTask PreviousSearchResultAsync() => InvokePreviewAsync("previousSearchResult");
    public ValueTask CloseSearchAsync() => InvokePreviewAsync("closeSearch");
    [JSInvokable] public Task OnPageChanged(int page) => PageChanged.InvokeAsync(page);
    [JSInvokable] public Task OnPreviewError(string message) => Error.InvokeAsync(message);
    public ValueTask SetThumbnailsVisibleAsync(bool visible) => InvokePreviewAsync("setThumbnailsVisible", visible);
    public ValueTask SetViewModeAsync(string mode) => InvokePreviewAsync("setViewMode", mode);
    public ValueTask GoToPageAsync(int page) => InvokePreviewAsync("goToPage", page);
    public ValueTask SetZoomAsync(double zoom) => InvokePreviewAsync("setZoom", zoom);
    public ValueTask FitWidthAsync() => InvokePreviewAsync("fitWidth");
    public ValueTask FitPageAsync() => InvokePreviewAsync("fitPage");

    private async ValueTask InvokePreviewAsync(string identifier, params object?[] args)
    {
        if (_disposed || _preview is null) return;
        try
        {
            await _preview.InvokeVoidAsync(identifier, args);
        }
        catch (JSDisconnectedException)
        {
            // 切断後の UI 操作は終了します。他の JavaScript エラーは呼び出し元へ伝えます。
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        // DOM の後始末は JavaScript の MutationObserver が担当します。
        try
        {
            if (_preview is not null) await _preview.DisposeAsync();
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _callback?.Dispose(); }
    }
}
