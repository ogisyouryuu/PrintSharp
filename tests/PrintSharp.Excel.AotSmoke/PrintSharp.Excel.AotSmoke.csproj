<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PrintSharp.Excel\PrintSharp.Excel.csproj" />
    <ProjectReference Include="..\..\src\PrintSharp.Excel.SourceGenerator\PrintSharp.Excel.SourceGenerator.csproj"
      OutputItemType="Analyzer"
      GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier"
      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
