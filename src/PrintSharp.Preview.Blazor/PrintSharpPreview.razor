@namespace PrintSharp.Preview.Blazor
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_container" style="height:@Height;min-height:200px" @attributes="AdditionalAttributes"></div>

@code {
    [Parameter, EditorRequired] public string DocumentId { get; set; } = "";
    [Parameter] public string BaseUrl { get; set; } = "/api/v1/previews";
    [Parameter] public int InitialPage { get; set; } = 1;
    [Parameter] public string Height { get; set; } = "600px";
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public EventCallback<string> Error { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    private ElementReference _container;
    private IJSObjectReference? _module;
    private IJSObjectReference? _preview;
    private DotNetObjectReference<PrintSharpPreview>? _callback;
    private (string, string, int)? _loaded;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || string.IsNullOrWhiteSpace(DocumentId) || _loaded == (BaseUrl, DocumentId, InitialPage)) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/PrintSharp.Preview.Blazor/preview.js");
        if (_disposed) { await _module.DisposeAsync(); return; }
        if (_preview is not null)
        {
            await _preview.InvokeVoidAsync("destroy");
            await _preview.DisposeAsync();
        }
        _callback ??= DotNetObjectReference.Create(this);
        _preview = await _module.InvokeAsync<IJSObjectReference>("mountBlazor", _container, BaseUrl, DocumentId, InitialPage, "fit-width", _callback);
        _loaded = (BaseUrl, DocumentId, InitialPage);
    }

    [JSInvokable] public Task OnPageChanged(int page) => PageChanged.InvokeAsync(page);
    [JSInvokable] public Task OnPreviewError(string message) => Error.InvokeAsync(message);
    public ValueTask GoToPageAsync(int page) => _preview?.InvokeVoidAsync("goToPage", page) ?? ValueTask.CompletedTask;
    public ValueTask SetZoomAsync(double zoom) => _preview?.InvokeVoidAsync("setZoom", zoom) ?? ValueTask.CompletedTask;
    public ValueTask FitWidthAsync() => _preview?.InvokeVoidAsync("fitWidth") ?? ValueTask.CompletedTask;
    public ValueTask FitPageAsync() => _preview?.InvokeVoidAsync("fitPage") ?? ValueTask.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        // DOM の後始末は JavaScript の MutationObserver が担当します。
        try
        {
            if (_preview is not null) await _preview.DisposeAsync();
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _callback?.Dispose(); }
    }
}
